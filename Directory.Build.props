<Project>
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
            <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src\ExerciseManager.Core\include;$(MSBuildThisFileDirectory)third_party;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExternalIncludeDirectories>$(MSBuildThisFileDirectory)third_party;%(ExternalIncludeDirectories)</ExternalIncludeDirectories>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>