PROJECT_NAME           = "ExerciseManager"
PROJECT_BRIEF          = "Personal C++ exercise manager with on-demand build and run"
OUTPUT_DIRECTORY       = output
CREATE_SUBDIRS         = NO
INPUT                  = ../src/ExerciseManager.Core ../docs/overview.md ../README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = ../docs/overview.md
EXAMPLE_PATH           = ../samples/ExerciseManager.Samples
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
EXTRACT_ALL            = YES
SOURCE_BROWSER         = YES
WARN_IF_UNDOCUMENTED   = YES
INPUT_ENCODING         = UTF-8
TAB_SIZE               = 4